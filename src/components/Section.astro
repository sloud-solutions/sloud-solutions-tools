---
interface Props {
  id?: string;
  background?: "white" | "alt";
  maxWidth?: "default" | "narrow" | "wide";
  class?: string;
}

const { id, background = "white", maxWidth = "default", class: className = "" } = Astro.props;

const backgroundClass = { white: "bg-white", alt: "bg-bg-alt" }[background];
const maxWidthClass = { default: "max-w-[1200px]", narrow: "max-w-[800px]", wide: "max-w-[1600px]" }[maxWidth];
---

<section id={id} class:list={["section-py", backgroundClass, className]}>
  <div class:list={["mx-auto px-4 sm:px-6 lg:px-8", maxWidthClass]}>
    <slot />
  </div>
</section>
