---
interface Props extends astroHTML.JSX.SVGAttributes {
  name: IconName;
  class?: string;
}

export type IconName =
  | "file-text"
  | "shield-check"
  | "users"
  | "arrow-right"
  | "mail"
  | "phone"
  | "map-pin"
  | "check"
  | "receipt"
  | "id-card"
  | "x"
  | "pencil"
  | "kanban"
  | "server";

const { name, class: className = "", ...rest } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  {...rest}
>
  {
    name === "file-text" && (
      <>
        <path d="M14 3.5H7.5a1.5 1.5 0 0 0-1.5 1.5v14a1.5 1.5 0 0 0 1.5 1.5h9a1.5 1.5 0 0 0 1.5-1.5V8Z" />
        <path d="M14 3.5V8h4" />
        <path d="M9 12.5h6M9 16h6" />
      </>
    )
  }
  {
    name === "shield-check" && (
      <>
        <path d="M12 3.5 5 6v5.5c0 4 3 6.9 7 9 4-2.1 7-5 7-9V6Z" />
        <path d="m9 12 2 2 4-4.5" />
      </>
    )
  }
  {
    name === "users" && (
      <>
        <circle cx="9" cy="8.5" r="3" />
        <path d="M3.5 19a5.5 5.5 0 0 1 11 0" />
        <path d="M16 5.8a3 3 0 0 1 0 5.4M17.5 14a5.5 5.5 0 0 1 3 5" />
      </>
    )
  }
  {
    name === "receipt" && (
      <>
        <path d="M6 3.5h12v17l-2.5-1.5L13 20.5 10.5 19 8 20.5 6 19z" />
        <path d="M9 8.5h6M9 12h6M9 15.5h3" />
      </>
    )
  }
  {
    name === "id-card" && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <circle cx="9" cy="11" r="2" />
        <path d="M5.8 16.5a3.4 3.4 0 0 1 6.4 0M14.5 10h3.5M14.5 13.5H18" />
      </>
    )
  }
  {name === "arrow-right" && <path d="M4.5 12h15m0 0-5.5-5.5M19.5 12 14 17.5" />}
  {
    name === "mail" && (
      <>
        <rect x="3.5" y="5.5" width="17" height="13" rx="2" />
        <path d="m4 7 8 6 8-6" />
      </>
    )
  }
  {
    name === "phone" && (
      <path d="M6.5 4h3l1.5 4-2 1.5a11 11 0 0 0 5.5 5.5L16 13l4 1.5v3a2 2 0 0 1-2 2A14.5 14.5 0 0 1 4.5 6a2 2 0 0 1 2-2Z" />
    )
  }
  {
    name === "map-pin" && (
      <>
        <path d="M12 20.5s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10Z" />
        <circle cx="12" cy="10.5" r="2.25" />
      </>
    )
  }
  {name === "check" && <path d="m5 12.5 4.5 4.5L19 7" />}
  {name === "x" && <path d="M6 6l12 12M18 6 6 18" />}
  {
    name === "pencil" && (
      <>
        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
        <path d="M14.5 5.5 18 9" />
      </>
    )
  }
  {
    name === "kanban" && (
      <>
        <rect x="3.5" y="4.5" width="17" height="15" rx="2" />
        <path d="M8.5 4.5v8M13 4.5v5M17.5 4.5v11" />
      </>
    )
  }
  {
    name === "server" && (
      <>
        <rect x="3.5" y="4" width="17" height="6.5" rx="1.5" />
        <rect x="3.5" y="13.5" width="17" height="6.5" rx="1.5" />
        <path d="M7 7.25h.01M7 16.75h.01" />
        <path d="M11 7.25h4M11 16.75h4" />
      </>
    )
  }
</svg>
