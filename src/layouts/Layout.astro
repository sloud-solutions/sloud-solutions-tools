---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import type { IconName } from "../components/Icon.astro";

interface Props {
  title?: string;
}

const { title = "Sloud Solutions | Internal Portal" } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

// data-page drives client-side filtering by the logged-in user's access list
// (see the script below) — every visitor's browser renders the same markup;
// what differs is which links get hidden after login.
const nav: { href: string; label: string; page: string; icon: IconName }[] = [
  { href: "/offer-letter", label: "Offer Letter", page: "offer-letter", icon: "file-text" },
  { href: "/company-policy", label: "Company Policy", page: "company-policy", icon: "shield-check" },
  { href: "/clients", label: "Clients", page: "clients", icon: "users" },
  { href: "/expenses", label: "Expense Tracker", page: "expenses", icon: "receipt" },
  { href: "/employees", label: "Employees", page: "employees", icon: "id-card" },
  { href: "/work-tracker", label: "Work Tracker", page: "work-tracker", icon: "kanban" },
];

// Admin-only, account-wide (Resource Explorer / job applications), so these
// are gated by role alone, not the per-employee page-access list like the
// items above.
const adminNav: { href: string; label: string; icon: IconName }[] = [
  { href: "/cloud-resources", label: "Cloud Resource Tracker", icon: "server" },
  { href: "/hrms", label: "HRMS", icon: "users" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/images/brand/sloud-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class="bg-bg text-text antialiased">
    <div class="flex min-h-screen">
      <!-- Sidebar: logo at top, all pages listed vertically below it -->
      <aside
        id="sidebar"
        class="fixed inset-y-0 left-0 z-40 flex w-72 -translate-x-full flex-col border-r border-border bg-white/90 backdrop-blur transition-transform duration-200 lg:sticky lg:top-0 lg:h-screen lg:translate-x-0"
      >
        <a href="/" class="flex items-center gap-3 border-b border-border px-5 py-4" aria-label="Sloud Solutions internal portal home">
          <img src="/images/brand/cropped_image.png" alt="Sloud Solutions" class="h-10 w-auto" width="459" height="185" />
          <span class="text-sm font-semibold text-text-muted">Internal Portal</span>
        </a>

        <nav aria-label="Primary" class="flex-1 space-y-1 overflow-y-auto p-3">
          {
            nav.map((item) => (
              <a
                href={item.href}
                data-page={item.page}
                aria-current={path === item.href ? "page" : undefined}
                class:list={[
                  "flex items-center gap-3 rounded-lg border-l-2 px-3 py-2.5 text-sm font-medium hover:bg-bg-alt hover:text-blue",
                  path === item.href ? "border-blue bg-bg-alt text-blue" : "border-transparent text-navy",
                ]}
              >
                <Icon name={item.icon} class="h-4 w-4 shrink-0" />
                {item.label}
              </a>
            ))
          }

          <div id="admin-nav-section" class="hidden">
            <p class="mt-4 px-3 text-xs font-semibold uppercase tracking-wide text-text-muted">Admin</p>
            <div class="mt-1 space-y-1">
              {
                adminNav.map((item) => (
                  <a
                    href={item.href}
                    data-admin-page="true"
                    aria-current={path === item.href ? "page" : undefined}
                    class:list={[
                      "flex items-center gap-3 rounded-lg border-l-2 px-3 py-2.5 text-sm font-medium hover:bg-bg-alt hover:text-blue",
                      path === item.href ? "border-blue bg-bg-alt text-blue" : "border-transparent text-navy",
                    ]}
                  >
                    <Icon name={item.icon} class="h-4 w-4 shrink-0" />
                    {item.label}
                  </a>
                ))
              }
            </div>
          </div>
        </nav>
      </aside>

      <!-- Backdrop for the mobile slide-in sidebar -->
      <div id="sidebar-backdrop" class="fixed inset-0 z-30 hidden bg-navy/40 lg:hidden"></div>

      <div class="flex min-h-screen flex-1 flex-col">
        <header class="sticky top-0 z-20 flex items-center justify-between gap-3 border-b border-border bg-white/95 px-4 py-3 backdrop-blur sm:px-6">
          <button
            id="sidebar-toggle"
            type="button"
            class="rounded-lg p-2 text-navy hover:bg-bg-alt lg:hidden"
            aria-label="Open menu"
            aria-controls="sidebar"
            aria-expanded="false"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="h-6 w-6" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <span class="hidden lg:block"></span>

          <!-- Top-right: account/user icon -->
          <div id="account-menu" class="relative hidden">
            <button
              id="account-trigger"
              type="button"
              class="relative block h-9 w-9 overflow-hidden rounded-full shadow-sm"
              aria-haspopup="true"
              aria-expanded="false"
              aria-label="Account menu"
            >
              <span id="account-initials" class="flex h-full w-full items-center justify-center bg-blue text-sm font-bold text-white hover:bg-blue-hover"></span>
              <img id="account-photo" alt="" class="hidden h-full w-full object-cover" />
            </button>

            <div
              id="account-dropdown"
              class="modal-panel absolute right-0 top-full z-50 mt-2 hidden w-80 origin-top-right rounded-xl border border-border bg-white p-4 shadow-lg"
              role="menu"
            >
              <div class="flex items-center gap-3">
                <span class="relative block h-12 w-12 shrink-0 overflow-hidden rounded-full">
                  <span id="account-initials-lg" class="flex h-full w-full items-center justify-center bg-blue text-base font-bold text-white"></span>
                  <img id="account-photo-lg" alt="" class="hidden h-full w-full object-cover" />
                </span>
                <p id="account-name" class="truncate text-base font-semibold text-navy"></p>
              </div>

              <div class="my-4 border-t border-border"></div>

              <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">Contact details</p>
              <p class="mt-2 flex items-center gap-2.5 text-sm text-text">
                <Icon name="mail" class="h-4 w-4 shrink-0 text-text-muted" />
                <span id="account-email" class="truncate"></span>
              </p>
              <p id="account-employee-id-row" class="mt-2 flex items-center gap-2.5 text-sm text-text">
                <Icon name="id-card" class="h-4 w-4 shrink-0 text-text-muted" />
                <span id="account-employee-id" class="truncate"></span>
              </p>
              <p id="account-job-title-row" class="mt-2 flex items-center gap-2.5 text-sm text-text">
                <Icon name="file-text" class="h-4 w-4 shrink-0 text-text-muted" />
                <span id="account-job-title" class="truncate"></span>
              </p>
              <p class="mt-2 flex items-center gap-2.5 text-sm text-text">
                <Icon name="shield-check" class="h-4 w-4 shrink-0 text-text-muted" />
                <span id="account-role-badge" class="rounded-full px-2.5 py-0.5 text-xs font-semibold"></span>
              </p>

              <div class="my-4 border-t border-border"></div>

              <button
                id="logout-button"
                type="button"
                class="w-full rounded-lg border border-border px-3 py-2 text-sm font-medium text-navy hover:bg-bg-alt hover:text-blue"
              >
                Log out
              </button>
            </div>
          </div>
        </header>

        <main class="flex-1">
          <slot />
        </main>
        <footer class="border-t border-border bg-white py-6 text-center text-xs text-text-muted">
          Sloud Solutions internal use only. Do not share.
        </footer>
      </div>
    </div>

    <style>
      /* Very faint, fixed watermark behind every page. A pseudo-element
         (rather than a background-image on body) so its low opacity never
         fades the real page content -- Section backgrounds are given a touch
         of transparency (see Section.astro) so this actually shows through. */
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -1;
        background-image: url("/images/brand/bg-skyline.webp");
        background-size: cover;
        background-position: center;
        opacity: 0.5;
        pointer-events: none;
      }
    </style>

    <script>
      import { isLoggedIn, logout } from "../lib/auth";
      import { loadMe, hasAccess, type PageKey } from "../lib/access";

      const navLinks = document.querySelectorAll<HTMLAnchorElement>("nav [data-page]");
      const adminNavLinks = document.querySelectorAll<HTMLAnchorElement>("nav [data-admin-page]");
      const adminNavSection = document.getElementById("admin-nav-section") as HTMLElement;
      const accountMenu = document.getElementById("account-menu") as HTMLElement;
      const accountTrigger = document.getElementById("account-trigger") as HTMLButtonElement;
      const accountDropdown = document.getElementById("account-dropdown") as HTMLElement;
      const accountInitials = document.getElementById("account-initials") as HTMLElement;
      const accountInitialsLg = document.getElementById("account-initials-lg") as HTMLElement;
      const accountPhoto = document.getElementById("account-photo") as HTMLImageElement;
      const accountPhotoLg = document.getElementById("account-photo-lg") as HTMLImageElement;
      const accountName = document.getElementById("account-name") as HTMLElement;
      const accountEmployeeIdRow = document.getElementById("account-employee-id-row") as HTMLElement;
      const accountEmployeeId = document.getElementById("account-employee-id") as HTMLElement;
      const accountJobTitleRow = document.getElementById("account-job-title-row") as HTMLElement;
      const accountJobTitle = document.getElementById("account-job-title") as HTMLElement;
      const accountEmail = document.getElementById("account-email") as HTMLElement;
      const accountRoleBadge = document.getElementById("account-role-badge") as HTMLElement;
      const logoutButton = document.getElementById("logout-button") as HTMLButtonElement;

      const sidebar = document.getElementById("sidebar") as HTMLElement;
      const sidebarBackdrop = document.getElementById("sidebar-backdrop") as HTMLElement;
      const sidebarToggle = document.getElementById("sidebar-toggle") as HTMLButtonElement;

      function openSidebar() {
        sidebar.classList.remove("-translate-x-full");
        sidebarBackdrop.classList.remove("hidden");
        sidebarToggle.setAttribute("aria-expanded", "true");
      }
      function closeSidebar() {
        sidebar.classList.add("-translate-x-full");
        sidebarBackdrop.classList.add("hidden");
        sidebarToggle.setAttribute("aria-expanded", "false");
      }
      sidebarToggle.addEventListener("click", () => {
        if (sidebar.classList.contains("-translate-x-full")) openSidebar();
        else closeSidebar();
      });
      sidebarBackdrop.addEventListener("click", closeSidebar);
      // Close the mobile drawer after navigating, and whenever the viewport
      // grows into the desktop breakpoint where the sidebar is always shown.
      navLinks.forEach((link) => link.addEventListener("click", closeSidebar));
      adminNavLinks.forEach((link) => link.addEventListener("click", closeSidebar));
      window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
        if (e.matches) closeSidebar();
      });

      const initialsOf = (name: string) =>
        name
          .trim()
          .split(/\s+/)
          .slice(0, 2)
          .map((part) => part[0]?.toUpperCase() ?? "")
          .join("") || "?";

      function closeDropdown() {
        accountDropdown.classList.add("hidden");
        accountTrigger.setAttribute("aria-expanded", "false");
      }
      function toggleDropdown() {
        const open = accountDropdown.classList.toggle("hidden") === false;
        accountTrigger.setAttribute("aria-expanded", String(open));
      }
      accountTrigger.addEventListener("click", (event) => {
        event.stopPropagation();
        toggleDropdown();
      });
      document.addEventListener("click", (event) => {
        if (!accountMenu.contains(event.target as Node)) closeDropdown();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeDropdown();
      });

      logoutButton.addEventListener("click", () => {
        logout();
        location.href = "/login";
      });

      if (isLoggedIn()) {
        loadMe()
          .then((me) => {
            navLinks.forEach((link) => {
              const page = link.dataset.page as PageKey;
              link.classList.toggle("hidden", !hasAccess(me, page));
            });
            adminNavLinks.forEach((link) => link.classList.toggle("hidden", me.role !== "Admin"));
            adminNavSection.classList.toggle("hidden", me.role !== "Admin");

            const initials = initialsOf(me.name || me.email || "");
            accountInitials.textContent = initials;
            accountInitialsLg.textContent = initials;
            if (me.photo) {
              accountPhoto.src = me.photo;
              accountPhotoLg.src = me.photo;
              accountPhoto.classList.remove("hidden");
              accountPhotoLg.classList.remove("hidden");
              accountInitials.classList.add("hidden");
              accountInitialsLg.classList.add("hidden");
            }
            accountName.textContent = me.name || me.email || "";
            accountEmployeeId.textContent = me.employeeId;
            accountEmployeeIdRow.classList.toggle("hidden", !me.employeeId);
            accountJobTitle.textContent = me.jobTitle;
            accountJobTitleRow.classList.toggle("hidden", !me.jobTitle);
            accountEmail.textContent = me.email ?? "";
            accountRoleBadge.textContent = me.role;
            accountRoleBadge.className =
              "rounded-full px-2.5 py-0.5 text-xs font-semibold " +
              (me.role === "Admin" ? "bg-navy/10 text-navy" : "bg-blue/10 text-blue");
            accountMenu.classList.remove("hidden");
          })
          .catch(() => {
            // /me failed (expired token, etc.) — leave nav as-is; the page's
            // own requireLogin()/requireAccess() guard will handle it.
          });
      } else {
        navLinks.forEach((link) => link.classList.add("hidden"));
      }
    </script>
  </body>
</html>
