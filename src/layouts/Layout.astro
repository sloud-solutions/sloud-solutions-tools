---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Sloud Solutions | Internal Portal" } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const nav = [
  { href: "/offer-letter", label: "Offer Letter" },
  { href: "/company-policy", label: "Company Policy" },
  { href: "/clients", label: "Clients" },
  { href: "/expenses", label: "Expense Tracker" },
  { href: "/employees", label: "Employees" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/images/brand/sloud-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class="bg-bg text-text antialiased">
    <header class="sticky top-0 z-50 border-b border-border bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-3" aria-label="Sloud Solutions internal portal home">
          <img src="/images/brand/cropped_image.png" alt="Sloud Solutions" class="h-10 w-auto sm:h-12" width="459" height="185" />
          <span class="hidden text-sm font-semibold text-text-muted sm:inline">Internal Portal</span>
        </a>
        <nav aria-label="Primary" class="flex flex-wrap items-center gap-1 sm:gap-2">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={path === item.href ? "page" : undefined}
                class:list={[
                  "rounded-lg px-3 py-2 text-sm font-medium hover:bg-bg-alt hover:text-blue",
                  path === item.href ? "bg-bg-alt text-blue" : "text-navy",
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <button
            id="logout-button"
            type="button"
            class="hidden rounded-lg border border-border px-3 py-2 text-sm font-medium text-navy hover:bg-bg-alt hover:text-blue"
          >
            Log out
          </button>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="border-t border-border bg-white py-6 text-center text-xs text-text-muted">
      Sloud Solutions internal use only. Do not share.
    </footer>
    <script>
      import { isLoggedIn, logout } from "../lib/auth";
      const button = document.getElementById("logout-button");
      if (button && isLoggedIn()) {
        button.classList.remove("hidden");
        button.addEventListener("click", () => {
          logout();
          location.href = "/login";
        });
      }
    </script>
  </body>
</html>
