---
import "../styles/global.css";
import Icon from "../components/Icon.astro";

interface Props {
  title?: string;
}

const { title = "Sloud Solutions | Internal Portal" } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

// data-page drives client-side filtering by the logged-in user's access list
// (see the script below) — every visitor's browser renders the same markup;
// what differs is which links get hidden after login.
const nav = [
  { href: "/offer-letter", label: "Offer Letter", page: "offer-letter" },
  { href: "/company-policy", label: "Company Policy", page: "company-policy" },
  { href: "/clients", label: "Clients", page: "clients" },
  { href: "/expenses", label: "Expense Tracker", page: "expenses" },
  { href: "/employees", label: "Employees", page: "employees" },
  { href: "/work-tracker", label: "Work Tracker", page: "work-tracker" },
];

// Admin-only, account-wide (Resource Explorer), so it's gated by role alone,
// not the per-employee page-access list like the items above.
const adminNav = [{ href: "/cloud-resources", label: "Cloud Resource Tracker" }];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/images/brand/sloud-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class="bg-bg text-text antialiased">
    <header class="sticky top-0 z-50 border-b border-border bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-3" aria-label="Sloud Solutions internal portal home">
          <img src="/images/brand/cropped_image.png" alt="Sloud Solutions" class="h-10 w-auto sm:h-12" width="459" height="185" />
          <span class="hidden text-sm font-semibold text-text-muted sm:inline">Internal Portal</span>
        </a>
        <nav aria-label="Primary" class="flex flex-wrap items-center gap-1 sm:gap-2">
          {
            nav.map((item) => (
              <a
                href={item.href}
                data-page={item.page}
                aria-current={path === item.href ? "page" : undefined}
                class:list={[
                  "rounded-lg px-3 py-2 text-sm font-medium hover:bg-bg-alt hover:text-blue",
                  path === item.href ? "bg-bg-alt text-blue" : "text-navy",
                ]}
              >
                {item.label}
              </a>
            ))
          }
          {
            adminNav.map((item) => (
              <a
                href={item.href}
                data-admin-page="true"
                aria-current={path === item.href ? "page" : undefined}
                class:list={[
                  "hidden rounded-lg px-3 py-2 text-sm font-medium hover:bg-bg-alt hover:text-blue",
                  path === item.href ? "bg-bg-alt text-blue" : "text-navy",
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <div id="account-menu" class="relative ml-1 hidden">
            <button
              id="account-trigger"
              type="button"
              class="relative block h-9 w-9 overflow-hidden rounded-full shadow-sm"
              aria-haspopup="true"
              aria-expanded="false"
              aria-label="Account menu"
            >
              <span id="account-initials" class="flex h-full w-full items-center justify-center bg-blue text-sm font-bold text-white hover:bg-blue-hover"></span>
              <img id="account-photo" alt="" class="hidden h-full w-full object-cover" />
            </button>

            <div
              id="account-dropdown"
              class="modal-panel absolute right-0 top-full z-50 mt-2 hidden w-80 origin-top-right rounded-xl border border-border bg-white p-4 shadow-lg"
              role="menu"
            >
              <div class="flex items-center gap-3">
                <span class="relative block h-12 w-12 shrink-0 overflow-hidden rounded-full">
                  <span id="account-initials-lg" class="flex h-full w-full items-center justify-center bg-blue text-base font-bold text-white"></span>
                  <img id="account-photo-lg" alt="" class="hidden h-full w-full object-cover" />
                </span>
                <p id="account-name" class="truncate text-base font-semibold text-navy"></p>
              </div>

              <div class="my-4 border-t border-border"></div>

              <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">Contact details</p>
              <p class="mt-2 flex items-center gap-2.5 text-sm text-text">
                <Icon name="mail" class="h-4 w-4 shrink-0 text-text-muted" />
                <span id="account-email" class="truncate"></span>
              </p>
              <p id="account-employee-id-row" class="mt-2 flex items-center gap-2.5 text-sm text-text">
                <Icon name="id-card" class="h-4 w-4 shrink-0 text-text-muted" />
                <span id="account-employee-id" class="truncate"></span>
              </p>
              <p id="account-job-title-row" class="mt-2 flex items-center gap-2.5 text-sm text-text">
                <Icon name="file-text" class="h-4 w-4 shrink-0 text-text-muted" />
                <span id="account-job-title" class="truncate"></span>
              </p>
              <p class="mt-2 flex items-center gap-2.5 text-sm text-text">
                <Icon name="shield-check" class="h-4 w-4 shrink-0 text-text-muted" />
                <span id="account-role-badge" class="rounded-full px-2.5 py-0.5 text-xs font-semibold"></span>
              </p>

              <div class="my-4 border-t border-border"></div>

              <button
                id="logout-button"
                type="button"
                class="w-full rounded-lg border border-border px-3 py-2 text-sm font-medium text-navy hover:bg-bg-alt hover:text-blue"
              >
                Log out
              </button>
            </div>
          </div>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="border-t border-border bg-white py-6 text-center text-xs text-text-muted">
      Sloud Solutions internal use only. Do not share.
    </footer>
    <script>
      import { isLoggedIn, logout } from "../lib/auth";
      import { loadMe, hasAccess, type PageKey } from "../lib/access";

      const navLinks = document.querySelectorAll<HTMLAnchorElement>("nav [data-page]");
      const adminNavLinks = document.querySelectorAll<HTMLAnchorElement>("nav [data-admin-page]");
      const accountMenu = document.getElementById("account-menu") as HTMLElement;
      const accountTrigger = document.getElementById("account-trigger") as HTMLButtonElement;
      const accountDropdown = document.getElementById("account-dropdown") as HTMLElement;
      const accountInitials = document.getElementById("account-initials") as HTMLElement;
      const accountInitialsLg = document.getElementById("account-initials-lg") as HTMLElement;
      const accountPhoto = document.getElementById("account-photo") as HTMLImageElement;
      const accountPhotoLg = document.getElementById("account-photo-lg") as HTMLImageElement;
      const accountName = document.getElementById("account-name") as HTMLElement;
      const accountEmployeeIdRow = document.getElementById("account-employee-id-row") as HTMLElement;
      const accountEmployeeId = document.getElementById("account-employee-id") as HTMLElement;
      const accountJobTitleRow = document.getElementById("account-job-title-row") as HTMLElement;
      const accountJobTitle = document.getElementById("account-job-title") as HTMLElement;
      const accountEmail = document.getElementById("account-email") as HTMLElement;
      const accountRoleBadge = document.getElementById("account-role-badge") as HTMLElement;
      const logoutButton = document.getElementById("logout-button") as HTMLButtonElement;

      const initialsOf = (name: string) =>
        name
          .trim()
          .split(/\s+/)
          .slice(0, 2)
          .map((part) => part[0]?.toUpperCase() ?? "")
          .join("") || "?";

      function closeDropdown() {
        accountDropdown.classList.add("hidden");
        accountTrigger.setAttribute("aria-expanded", "false");
      }
      function toggleDropdown() {
        const open = accountDropdown.classList.toggle("hidden") === false;
        accountTrigger.setAttribute("aria-expanded", String(open));
      }
      accountTrigger.addEventListener("click", (event) => {
        event.stopPropagation();
        toggleDropdown();
      });
      document.addEventListener("click", (event) => {
        if (!accountMenu.contains(event.target as Node)) closeDropdown();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeDropdown();
      });

      logoutButton.addEventListener("click", () => {
        logout();
        location.href = "/login";
      });

      if (isLoggedIn()) {
        loadMe()
          .then((me) => {
            navLinks.forEach((link) => {
              const page = link.dataset.page as PageKey;
              link.classList.toggle("hidden", !hasAccess(me, page));
            });
            adminNavLinks.forEach((link) => link.classList.toggle("hidden", me.role !== "Admin"));

            const initials = initialsOf(me.name || me.email || "");
            accountInitials.textContent = initials;
            accountInitialsLg.textContent = initials;
            if (me.photo) {
              accountPhoto.src = me.photo;
              accountPhotoLg.src = me.photo;
              accountPhoto.classList.remove("hidden");
              accountPhotoLg.classList.remove("hidden");
              accountInitials.classList.add("hidden");
              accountInitialsLg.classList.add("hidden");
            }
            accountName.textContent = me.name || me.email || "";
            accountEmployeeId.textContent = me.employeeId;
            accountEmployeeIdRow.classList.toggle("hidden", !me.employeeId);
            accountJobTitle.textContent = me.jobTitle;
            accountJobTitleRow.classList.toggle("hidden", !me.jobTitle);
            accountEmail.textContent = me.email ?? "";
            accountRoleBadge.textContent = me.role;
            accountRoleBadge.className =
              "rounded-full px-2.5 py-0.5 text-xs font-semibold " +
              (me.role === "Admin" ? "bg-navy/10 text-navy" : "bg-blue/10 text-blue");
            accountMenu.classList.remove("hidden");
          })
          .catch(() => {
            // /me failed (expired token, etc.) — leave nav as-is; the page's
            // own requireLogin()/requireAccess() guard will handle it.
          });
      } else {
        navLinks.forEach((link) => link.classList.add("hidden"));
      }
    </script>
  </body>
</html>
