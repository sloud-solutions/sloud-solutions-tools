---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="HRMS | Sloud Solutions Portal">
  <div id="app" class="hidden">
    <Section background="white" maxWidth="wide" class="animate-in">
      <div class="text-center">
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-blue/10 text-blue">
          <Icon name="users" class="h-7 w-7" />
        </span>
        <p class="mt-4 text-sm font-semibold uppercase tracking-wider text-blue">Admin</p>
        <h1 class="mt-2 text-4xl font-bold leading-tight sm:text-5xl">HRMS</h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed">
          Review job applications submitted through the careers page, download resumes, and tag each candidate for
          the next step. More HRMS modules will land here over time — Resumes is the first.
        </p>
      </div>
    </Section>

    <Section background="alt" maxWidth="wide">
      <!-- Section tabs (Resumes is the only functional one today) -->
      <div class="flex gap-2 border-b border-border">
        <span class="border-b-2 border-blue px-1 pb-3 text-sm font-semibold text-blue">Resumes</span>
      </div>

      <!-- Summary stat cards -->
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-border bg-white p-5 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-wider text-text-muted">Total applications</p>
          <p id="stat-total" class="mt-2 text-3xl font-bold text-navy">–</p>
        </div>
        <div class="rounded-xl border border-border bg-white p-5 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-wider text-text-muted">Pending review</p>
          <p id="stat-pending" class="mt-2 text-3xl font-bold text-navy">–</p>
        </div>
        <div class="rounded-xl border border-border bg-white p-5 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-wider text-emerald-700">Consider</p>
          <p id="stat-consider" class="mt-2 text-3xl font-bold text-emerald-700">–</p>
        </div>
        <div class="rounded-xl border border-border bg-white p-5 shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-wider text-text-muted">Not consider</p>
          <p id="stat-not-consider" class="mt-2 text-3xl font-bold text-text-muted">–</p>
        </div>
      </div>

      <!-- Toolbar -->
      <div class="mt-8 flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-xl">Applications <span id="count" class="text-sm font-normal text-text-muted"></span></h2>
        <div class="flex flex-wrap gap-2">
          <input
            id="search"
            type="search"
            placeholder="Search name, email, or job title"
            aria-label="Search applications"
            class="w-64 rounded-lg border border-border bg-white px-3 py-2 text-sm focus-visible:border-blue"
          />
          <select id="filter-segment" class="rounded-lg border border-border bg-white px-3 py-2 text-sm" aria-label="Filter by segment">
            <option value="">All segments</option>
          </select>
          <select id="filter-status" class="rounded-lg border border-border bg-white px-3 py-2 text-sm" aria-label="Filter by status">
            <option value="">All statuses</option>
            <option value="pending">Pending</option>
            <option value="consider">Consider</option>
            <option value="not_consider">Not Consider</option>
          </select>
          <button id="refresh-button" type="button" class="rounded-lg border border-border bg-white px-3 py-2 text-sm font-semibold text-navy hover:bg-bg-alt">
            Refresh
          </button>
        </div>
      </div>

      <!-- Bulk action bar -->
      <div id="bulk-bar" class="mt-4 hidden flex-wrap items-center gap-3 rounded-lg border border-blue/30 bg-blue/5 px-4 py-3">
        <span id="bulk-count" class="text-sm font-semibold text-navy"></span>
        <button id="bulk-consider" type="button" class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700">
          Mark Consider
        </button>
        <button id="bulk-not-consider" type="button" class="rounded-lg bg-bg-alt px-3 py-1.5 text-xs font-semibold text-navy hover:bg-border">
          Mark Not Consider
        </button>
        <button id="bulk-delete" type="button" class="rounded-lg bg-red-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-red-700">
          Delete selected
        </button>
        <button id="bulk-clear" type="button" class="ml-auto text-xs font-medium text-text-muted hover:underline">
          Clear selection
        </button>
      </div>

      <p id="error-banner" class="mt-6 hidden rounded-lg bg-red-50 p-3 text-sm text-red-800" role="alert"></p>
      <p id="loading-note" class="mt-6 text-sm text-text-muted">Loading…</p>

      <div id="table-wrap" class="mt-6 hidden overflow-x-auto rounded-xl border border-border bg-white shadow-sm">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-border bg-bg-alt text-xs font-semibold uppercase tracking-wide text-text-muted">
            <tr>
              <th class="px-4 py-3">
                <input id="select-all" type="checkbox" aria-label="Select all applications" />
              </th>
              <th class="px-4 py-3">Applicant</th>
              <th class="px-4 py-3">Job</th>
              <th class="px-4 py-3">Segment</th>
              <th class="px-4 py-3">Resume uploaded</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody id="table-body"></tbody>
        </table>
      </div>
      <p id="empty" class="mt-10 hidden text-center text-sm text-text-muted">No applications match your search.</p>
    </Section>

    <!-- Applicant detail modal -->
    <div id="detail-modal" class="modal-backdrop fixed inset-0 z-50 hidden items-center justify-center bg-navy/40 p-4">
      <div class="modal-panel w-full max-w-lg rounded-xl bg-white p-6 shadow-2xl sm:p-8">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h2 id="detail-name" class="text-xl"></h2>
            <p id="detail-job" class="mt-1 text-sm text-text-muted"></p>
          </div>
          <button id="detail-close" type="button" class="rounded-md p-1 text-text-muted hover:bg-bg-alt hover:text-navy" aria-label="Close">✕</button>
        </div>

        <dl class="mt-5 space-y-3 text-sm">
          <div class="flex justify-between gap-3">
            <dt class="font-medium text-navy">Email</dt>
            <dd id="detail-email" class="text-right text-text"></dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="font-medium text-navy">Phone</dt>
            <dd id="detail-phone" class="text-right text-text"></dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="font-medium text-navy">Segment</dt>
            <dd id="detail-segment" class="text-right text-text"></dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="font-medium text-navy">Resume uploaded</dt>
            <dd id="detail-submitted" class="text-right text-text"></dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="font-medium text-navy">Status</dt>
            <dd id="detail-status" class="text-right text-text"></dd>
          </div>
        </dl>

        <div class="mt-4 border-t border-border pt-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">Cover note</p>
          <p id="detail-note" class="mt-2 whitespace-pre-wrap text-sm text-text">–</p>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-2 border-t border-border pt-5">
          <a
            id="detail-resume-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg bg-blue px-4 py-2 text-sm font-semibold text-white hover:bg-blue-hover"
          >
            <Icon name="file-text" class="h-4 w-4" />
            View resume
          </a>
          <button id="detail-consider" type="button" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">
            Mark Consider
          </button>
          <button id="detail-not-consider" type="button" class="rounded-lg bg-bg-alt px-4 py-2 text-sm font-semibold text-navy hover:bg-border">
            Mark Not Consider
          </button>
          <button id="detail-delete" type="button" class="ml-auto rounded-lg px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50">
            Delete
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { requireLogin } from "../lib/auth";
  import { loadMe } from "../lib/access";
  import {
    listResumes,
    getResumeUrl,
    deleteResume,
    updateResumeStatus,
    ApiError,
    type Application,
    type ResumeStatus,
  } from "../lib/api";

  const STATUS_LABEL: Record<ResumeStatus, string> = { pending: "Pending", consider: "Consider", not_consider: "Not Consider" };
  const STATUS_BADGE: Record<ResumeStatus, string> = {
    pending: "bg-bg-alt text-text-muted",
    consider: "bg-emerald-100 text-emerald-700",
    not_consider: "bg-border text-text-muted",
  };

  async function init() {
    if (!requireLogin()) return;

    const me = await loadMe();
    if (me.role !== "Admin") {
      location.replace("/"); // only shows the pages this person actually has, no "denied" message
      return;
    }
    document.getElementById("app")!.classList.remove("hidden");

    const $ = (id: string) => document.getElementById(id)!;
    const loadingNote = $("loading-note");
    const errorBanner = $("error-banner");
    const tableWrap = $("table-wrap");
    const tableBody = $("table-body");
    const empty = $("empty");
    const search = $("search") as HTMLInputElement;
    const filterSegment = $("filter-segment") as HTMLSelectElement;
    const filterStatus = $("filter-status") as HTMLSelectElement;
    const refreshButton = $("refresh-button") as HTMLButtonElement;
    const selectAll = $("select-all") as HTMLInputElement;
    const statTotal = $("stat-total");
    const statPending = $("stat-pending");
    const statConsider = $("stat-consider");
    const statNotConsider = $("stat-not-consider");
    const bulkBar = $("bulk-bar");
    const bulkCount = $("bulk-count");

    const detailModal = $("detail-modal");
    const detailName = $("detail-name");
    const detailJob = $("detail-job");
    const detailEmail = $("detail-email");
    const detailPhone = $("detail-phone");
    const detailSegment = $("detail-segment");
    const detailSubmitted = $("detail-submitted");
    const detailStatus = $("detail-status");
    const detailNote = $("detail-note");
    const detailResumeLink = $("detail-resume-link") as HTMLAnchorElement;
    const detailConsider = $("detail-consider") as HTMLButtonElement;
    const detailNotConsider = $("detail-not-consider") as HTMLButtonElement;
    const detailDelete = $("detail-delete") as HTMLButtonElement;

    let applications: Application[] = [];
    const selected = new Set<string>();
    let detailId: string | null = null;

    const showError = (message: string) => {
      errorBanner.textContent = message;
      errorBanner.classList.remove("hidden");
    };

    function fmtDateTime(iso: string): string {
      if (!iso) return "–";
      return new Date(iso).toLocaleString("en-IN", { day: "2-digit", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" });
    }

    function el<K extends keyof HTMLElementTagNameMap>(tag: K, className = "", text?: string): HTMLElementTagNameMap[K] {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    }

    function populateFilters() {
      const segments = [...new Set(applications.map((a) => a.segment))].sort();
      const current = filterSegment.value;
      filterSegment.innerHTML = '<option value="">All segments</option>';
      segments.forEach((s) => {
        const opt = el("option", "", s) as HTMLOptionElement;
        opt.value = s;
        filterSegment.append(opt);
      });
      filterSegment.value = segments.includes(current) ? current : "";
    }

    function renderStats() {
      statTotal.textContent = String(applications.length);
      statPending.textContent = String(applications.filter((a) => a.status === "pending").length);
      statConsider.textContent = String(applications.filter((a) => a.status === "consider").length);
      statNotConsider.textContent = String(applications.filter((a) => a.status === "not_consider").length);
    }

    function visibleApplications(): Application[] {
      const query = search.value.trim().toLowerCase();
      return applications.filter((a) => {
        if (filterSegment.value && a.segment !== filterSegment.value) return false;
        if (filterStatus.value && a.status !== filterStatus.value) return false;
        if (!query) return true;
        return a.name.toLowerCase().includes(query) || a.email.toLowerCase().includes(query) || a.jobTitle.toLowerCase().includes(query);
      });
    }

    function renderBulkBar() {
      bulkBar.classList.toggle("hidden", selected.size === 0);
      bulkBar.classList.toggle("flex", selected.size > 0);
      bulkCount.textContent = `${selected.size} selected`;
    }

    function renderTable() {
      const shown = visibleApplications();

      $("count").textContent = `(${shown.length} of ${applications.length})`;
      empty.classList.toggle("hidden", shown.length > 0);
      tableWrap.classList.toggle("hidden", shown.length === 0);

      const shownIds = new Set(shown.map((a) => a.id));
      [...selected].forEach((id) => {
        if (!shownIds.has(id)) selected.delete(id);
      });
      selectAll.checked = shown.length > 0 && shown.every((a) => selected.has(a.id));
      renderBulkBar();

      tableBody.replaceChildren(
        ...shown.map((a) => {
          const row = el("tr", "border-b border-border last:border-0 hover:bg-bg-alt");

          const checkCell = el("td", "px-4 py-3");
          const checkbox = document.createElement("input");
          checkbox.type = "checkbox";
          checkbox.checked = selected.has(a.id);
          checkbox.setAttribute("aria-label", `Select ${a.name}`);
          checkbox.addEventListener("change", () => {
            if (checkbox.checked) selected.add(a.id);
            else selected.delete(a.id);
            renderTable();
          });
          checkCell.append(checkbox);

          const applicantCell = el("td", "px-4 py-3");
          const nameLink = el("button", "font-medium text-navy hover:text-blue hover:underline", a.name) as HTMLButtonElement;
          nameLink.type = "button";
          nameLink.addEventListener("click", () => openDetail(a.id));
          const emailLine = el("div", "text-xs text-text-muted", a.email);
          applicantCell.append(nameLink, emailLine);

          const jobCell = el("td", "px-4 py-3 text-text", a.jobTitle);
          const segmentCell = el("td", "px-4 py-3 text-text-muted", a.segment);
          const submittedCell = el("td", "px-4 py-3 text-text-muted", fmtDateTime(a.submittedAt));

          const statusCell = el("td", "px-4 py-3");
          const badge = el("span", `inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${STATUS_BADGE[a.status]}`, STATUS_LABEL[a.status]);
          statusCell.append(badge);

          const actionsCell = el("td", "px-4 py-3 text-right");
          const viewButton = el("button", "text-xs font-medium text-blue hover:underline", "View") as HTMLButtonElement;
          viewButton.type = "button";
          viewButton.addEventListener("click", () => openDetail(a.id));
          actionsCell.append(viewButton);

          row.append(checkCell, applicantCell, jobCell, segmentCell, submittedCell, statusCell, actionsCell);
          return row;
        }),
      );
    }

    function renderAll() {
      populateFilters();
      renderStats();
      renderTable();
    }

    async function load() {
      try {
        const data = await listResumes();
        applications = data.applications;
        errorBanner.classList.add("hidden");
      } catch (err) {
        showError(err instanceof ApiError ? err.message : "Could not load applications from AWS.");
        return;
      } finally {
        loadingNote.classList.add("hidden");
      }
      renderAll();
    }

    async function setStatus(ids: string[], status: ResumeStatus) {
      await Promise.all(
        ids.map(async (id) => {
          try {
            const updated = await updateResumeStatus(id, status);
            const idx = applications.findIndex((a) => a.id === id);
            if (idx !== -1) applications[idx] = updated;
          } catch (err) {
            showError(err instanceof ApiError ? err.message : `Could not update ${id}.`);
          }
        }),
      );
      renderAll();
    }

    async function removeApplications(ids: string[]) {
      await Promise.all(
        ids.map(async (id) => {
          try {
            await deleteResume(id);
            applications = applications.filter((a) => a.id !== id);
            selected.delete(id);
          } catch (err) {
            showError(err instanceof ApiError ? err.message : `Could not delete ${id}.`);
          }
        }),
      );
      renderAll();
    }

    function openDetail(id: string) {
      const a = applications.find((x) => x.id === id);
      if (!a) return;
      detailId = id;
      detailName.textContent = a.name;
      detailJob.textContent = `${a.jobTitle} · ${a.segment}`;
      detailEmail.textContent = a.email;
      detailPhone.textContent = a.phone;
      detailSegment.textContent = a.segment;
      detailSubmitted.textContent = fmtDateTime(a.submittedAt);
      detailStatus.textContent = STATUS_LABEL[a.status];
      detailNote.textContent = a.coverNote || "–";
      detailResumeLink.href = "#";
      getResumeUrl(id)
        .then(({ url }) => {
          detailResumeLink.href = url;
        })
        .catch(() => {
          detailResumeLink.href = "#";
        });
      detailModal.classList.remove("hidden");
      detailModal.classList.add("flex");
      document.body.classList.add("overflow-hidden");
    }

    function closeDetail() {
      detailId = null;
      detailModal.classList.add("hidden");
      detailModal.classList.remove("flex");
      document.body.classList.remove("overflow-hidden");
    }

    search.addEventListener("input", renderTable);
    filterSegment.addEventListener("change", renderTable);
    filterStatus.addEventListener("change", renderTable);
    refreshButton.addEventListener("click", () => {
      refreshButton.disabled = true;
      load().finally(() => {
        refreshButton.disabled = false;
      });
    });

    selectAll.addEventListener("change", () => {
      const shown = visibleApplications();
      if (selectAll.checked) shown.forEach((a) => selected.add(a.id));
      else shown.forEach((a) => selected.delete(a.id));
      renderTable();
    });

    $("bulk-clear").addEventListener("click", () => {
      selected.clear();
      renderTable();
    });
    $("bulk-consider").addEventListener("click", () => setStatus([...selected], "consider"));
    $("bulk-not-consider").addEventListener("click", () => setStatus([...selected], "not_consider"));
    $("bulk-delete").addEventListener("click", () => {
      if (!confirm(`Delete ${selected.size} application(s) and their resumes? This can't be undone.`)) return;
      removeApplications([...selected]);
    });

    $("detail-close").addEventListener("click", closeDetail);
    detailModal.addEventListener("click", (e) => {
      if (e.target === detailModal) closeDetail();
    });
    detailConsider.addEventListener("click", () => {
      if (detailId) setStatus([detailId], "consider");
    });
    detailNotConsider.addEventListener("click", () => {
      if (detailId) setStatus([detailId], "not_consider");
    });
    detailDelete.addEventListener("click", () => {
      if (!detailId) return;
      if (!confirm("Delete this application and its resume? This can't be undone.")) return;
      removeApplications([detailId]);
      closeDetail();
    });

    await load();
  }

  init();
</script>
