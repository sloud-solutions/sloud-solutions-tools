---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Field from "../components/Field.astro";
import Icon from "../components/Icon.astro";
import { EXPENSE_CATEGORIES, PAYMENT_STATUSES, AUTO_RENEWAL_OPTIONS, DOCUMENT_ACCEPT, DOCUMENT_MAX_BYTES } from "../data/expenses";

const today = new Date().toISOString().slice(0, 10);
const selectClass = "mt-1.5 w-full rounded-lg border border-border bg-white px-3.5 py-2.5 text-sm text-text focus-visible:border-blue";
const maxDocumentMb = DOCUMENT_MAX_BYTES / (1024 * 1024);
---

<Layout title="Expense Tracker | Sloud Solutions Portal">
  <div id="app" class="hidden">
    <Section background="white" maxWidth="narrow" class="animate-in text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-blue">Finance</p>
      <h1 class="mt-4 text-4xl font-bold leading-tight sm:text-5xl">Expense Tracker</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed">Record every company purchase and keep them in one place.</p>
    </Section>

    <Section background="alt">
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="animate-in rounded-xl border border-border bg-white p-5 shadow-sm" style="animation-delay:0ms">
          <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">Total spend</p>
          <p id="stat-total" class="mt-2 text-2xl font-bold text-navy">–</p>
        </div>
        <div class="animate-in rounded-xl border border-border bg-white p-5 shadow-sm" style="animation-delay:70ms">
          <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">This month</p>
          <p id="stat-month" class="mt-2 text-2xl font-bold text-navy">–</p>
        </div>
        <div class="animate-in rounded-xl border border-border bg-white p-5 shadow-sm" style="animation-delay:140ms">
          <p class="text-xs font-semibold uppercase tracking-wide text-text-muted">Awaiting payment / reimbursement</p>
          <p id="stat-open" class="mt-2 text-2xl font-bold text-navy">–</p>
        </div>
      </div>

      <p id="error-banner" class="mt-6 hidden rounded-lg bg-red-50 p-3 text-sm text-red-800" role="alert"></p>
      <p id="loading-note" class="mt-6 text-sm text-text-muted">Loading…</p>

      <div id="content" class="mt-8 hidden grid items-start gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,2fr)]">
        <div class="rounded-xl border border-border bg-white shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border p-5">
            <h2 class="text-xl">Purchases <span id="count" class="text-sm font-normal text-text-muted"></span></h2>
            <div class="flex flex-wrap gap-2">
              <input
                id="search-box"
                type="search"
                placeholder="Search item, vendor, paid by, notes…"
                aria-label="Search purchases"
                class="w-56 rounded-lg border border-border bg-white px-3 py-2 text-sm focus-visible:border-blue"
              />
              <select id="filter-category" class="rounded-lg border border-border bg-white px-3 py-2 text-sm" aria-label="Filter by category">
                <option value="">All categories</option>
                {EXPENSE_CATEGORIES.map((c) => <option>{c}</option>)}
              </select>
              <select id="filter-status" class="rounded-lg border border-border bg-white px-3 py-2 text-sm" aria-label="Filter by status">
                <option value="">All statuses</option>
                {PAYMENT_STATUSES.map((s) => <option>{s}</option>)}
              </select>
              <select id="sort-by" class="rounded-lg border border-border bg-white px-3 py-2 text-sm" aria-label="Sort by">
                <option value="date-desc">Date (newest)</option>
                <option value="date-asc">Date (oldest)</option>
                <option value="amount-desc">Amount (high to low)</option>
                <option value="amount-asc">Amount (low to high)</option>
                <option value="expiry-asc">Expiry (soonest)</option>
                <option value="item-asc">Item (A–Z)</option>
              </select>
              <button
                id="download-excel"
                type="button"
                class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-white px-3 py-2 text-sm font-medium text-navy hover:bg-bg-alt"
              >
                <Icon name="file-text" class="h-4 w-4" />
                Download
              </button>
            </div>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="bg-bg-alt text-xs uppercase tracking-wide text-text-muted">
                <tr>
                  <th class="px-3 py-3 font-semibold">#</th>
                  <th class="px-3 py-3 font-semibold">Date</th>
                  <th class="px-3 py-3 font-semibold">Item</th>
                  <th class="px-3 py-3 font-semibold">Category</th>
                  <th class="px-3 py-3 font-semibold">Paid by</th>
                  <th class="px-3 py-3 text-right font-semibold">Amount</th>
                  <th class="px-3 py-3 font-semibold">Status</th>
                  <th class="px-3 py-3 font-semibold">Expiry</th>
                  <th class="px-3 py-3 font-semibold">Document</th>
                  <th class="px-3 py-3"><span class="sr-only">Actions</span></th>
                </tr>
              </thead>
              <tbody id="rows" class="divide-y divide-border"></tbody>
              <template id="icon-tpl-edit"><Icon name="pencil" class="h-4 w-4" /></template>
              <template id="icon-tpl-delete"><Icon name="x" class="h-4 w-4" /></template>
              <tfoot>
                <tr class="border-t border-border bg-bg-alt">
                  <td colspan="5" class="px-3 py-3 text-right text-xs font-semibold uppercase tracking-wide text-text-muted">Total shown</td>
                  <td id="shown-total" class="px-3 py-3 text-right font-semibold text-navy"></td>
                  <td colspan="4"></td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>

        <form id="expense-form" class="space-y-5 rounded-xl border border-border bg-white p-6 shadow-sm lg:sticky lg:top-24" novalidate>
          <h2 id="form-heading" class="text-xl">Add purchase</h2>
          <Field id="date" label="Purchase date" type="date" required value={today} />
          <Field id="item" label="Item / description" required placeholder="e.g. Laptop, AWS bill" />
          <Field id="vendor" label="Vendor" required />
          <div>
            <label for="category" class="block text-sm font-medium text-navy">Category <span class="text-red-600" aria-hidden="true">*</span></label>
            <select id="category" name="category" required class={selectClass}>
              {EXPENSE_CATEGORIES.map((c) => <option>{c}</option>)}
            </select>
          </div>
          <Field id="amount" label="Amount (INR)" type="number" required min="1" />
          <div>
            <label for="paidBy" class="block text-sm font-medium text-navy">Paid by <span class="text-red-600" aria-hidden="true">*</span></label>
            <select id="paidBy" name="paidBy" required class={selectClass}>
              <option value="">Loading employees…</option>
            </select>
          </div>
          <div>
            <label for="status" class="block text-sm font-medium text-navy">Status</label>
            <select id="status" name="status" class={selectClass}>
              {PAYMENT_STATUSES.map((s) => <option>{s}</option>)}
            </select>
          </div>
          <Field id="notes" label="Notes" placeholder="Invoice number, remarks" />
          <Field id="expiryDate" label="Expiry date" type="date" required />
          <div>
            <label for="autoRenewal" class="block text-sm font-medium text-navy">Auto renewal <span class="text-red-600" aria-hidden="true">*</span></label>
            <select id="autoRenewal" name="autoRenewal" required class={selectClass}>
              <option value="">Select…</option>
              {AUTO_RENEWAL_OPTIONS.map((o) => <option>{o}</option>)}
            </select>
          </div>
          <div>
            <label for="document" class="block text-sm font-medium text-navy">Bill / payment document</label>
            <input
              id="document"
              name="document"
              type="file"
              accept={DOCUMENT_ACCEPT}
              class="mt-1.5 w-full rounded-lg border border-border bg-white px-3.5 py-2.5 text-sm text-text file:mr-3 file:rounded-md file:border-0 file:bg-bg-alt file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-navy focus-visible:border-blue"
            />
            <p class="mt-1 text-xs text-text-muted">PDF, JPG, or PNG, up to {maxDocumentMb} MB.</p>
            <p id="existing-document" class="mt-1 hidden text-xs text-text-muted"></p>
            <p id="document-error" class="mt-1 hidden text-xs text-red-600"></p>
          </div>
          <button id="submit-button" type="submit" class="w-full rounded-lg bg-blue px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-hover">
            Add purchase
          </button>
          <button
            id="cancel-edit"
            type="button"
            class="hidden w-full rounded-lg border border-border px-6 py-2.5 text-sm font-medium text-navy hover:bg-bg-alt"
          >
            Cancel edit
          </button>
          <p class="text-xs text-text-muted">Visible to everyone with access to the Expense Tracker.</p>
        </form>
      </div>
    </Section>
  </div>

</Layout>

<script>
  import { requireLogin } from "../lib/auth";
  import { loadMe, hasAccess } from "../lib/access";
  import { listExpenses, createExpense, updateExpense, deleteExpense, uploadExpenseDocument, listEmployeeOptions, type EmployeeOption, ApiError } from "../lib/api";
  import type { Expense } from "../data/expenses";
  import { DOCUMENT_ALLOWED_TYPES, DOCUMENT_MAX_BYTES } from "../data/expenses";

  async function init() {
    if (!requireLogin()) return;

    const me = await loadMe();
    if (!hasAccess(me, "expenses")) {
      location.replace("/"); // only shows the pages this person actually has, no "denied" message
      return;
    }
    document.getElementById("app")!.classList.remove("hidden");

    const $ = (id: string) => document.getElementById(id)!;
    const loadingNote = $("loading-note");
    const errorBanner = $("error-banner");
    const content = $("content");
    const showError = (message: string) => {
      errorBanner.textContent = message;
      errorBanner.classList.remove("hidden");
    };

    let expenses: Expense[] = [];
    try {
      expenses = await listExpenses();
    } catch (err) {
      loadingNote.classList.add("hidden");
      showError(err instanceof ApiError ? err.message : "Could not load expenses. Please try again.");
      return;
    }
    loadingNote.classList.add("hidden");
    content.classList.remove("hidden");

    const paidBySelect = $("paidBy") as HTMLSelectElement;
    let employeeOptions: EmployeeOption[] = [];
    try {
      employeeOptions = await listEmployeeOptions();
    } catch {
      // Fall back to whoever has already been recorded as "paid by", so the form still works.
      const seen = new Set<string>();
      employeeOptions = expenses
        .map((e) => e.paidBy)
        .filter((name) => name && !seen.has(name) && seen.add(name))
        .map((name) => ({ id: name, name }));
    }
    const paidByLabel = (o: EmployeeOption) => (o.employeeId ? `${o.employeeId} — ${o.name}` : o.name);
    function populatePaidBySelect() {
      const sorted = [...employeeOptions].sort((a, b) => paidByLabel(a).localeCompare(paidByLabel(b)));
      paidBySelect.replaceChildren(
        new Option("Select…", ""),
        ...sorted.map((o) => new Option(paidByLabel(o), paidByLabel(o))),
      );
    }
    // Keeps a value already on a purchase selectable even if it's a disabled/removed
    // employee or a free-text value from before this dropdown existed.
    function ensurePaidByOption(value: string) {
      if (!value || [...paidBySelect.options].some((o) => o.value === value)) return;
      paidBySelect.add(new Option(value, value));
    }
    populatePaidBySelect();

    const rows = $("rows");
    const filterCategory = $("filter-category") as HTMLSelectElement;
    const filterStatus = $("filter-status") as HTMLSelectElement;
    const searchBox = $("search-box") as HTMLInputElement;
    const sortBy = $("sort-by") as HTMLSelectElement;
    const form = $("expense-form") as HTMLFormElement;
    const formHeading = $("form-heading");
    const submitButton = $("submit-button") as HTMLButtonElement;
    const cancelEditButton = $("cancel-edit") as HTMLButtonElement;
    const existingDocumentNote = $("existing-document");

    let editingId: string | null = null;
    let editingDocument = { documentUrl: "", documentName: "" };

    function iconButton(templateId: string, label: string, extraClass: string) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = `inline-flex h-7 w-7 items-center justify-center rounded-md text-text-muted hover:bg-bg-alt ${extraClass}`;
      btn.setAttribute("aria-label", label);
      const tpl = document.getElementById(templateId) as HTMLTemplateElement;
      btn.append(tpl.content.cloneNode(true));
      return btn;
    }

    function enterAddMode() {
      editingId = null;
      editingDocument = { documentUrl: "", documentName: "" };
      form.reset();
      (form.elements.namedItem("date") as HTMLInputElement).value = new Date().toISOString().slice(0, 10);
      formHeading.textContent = "Add purchase";
      submitButton.textContent = "Add purchase";
      cancelEditButton.classList.add("hidden");
      existingDocumentNote.classList.add("hidden");
    }

    function enterEditMode(e: Expense) {
      editingId = e.id;
      editingDocument = { documentUrl: e.documentUrl ?? "", documentName: e.documentName ?? "" };
      (form.elements.namedItem("date") as HTMLInputElement).value = e.date;
      (form.elements.namedItem("item") as HTMLInputElement).value = e.item;
      (form.elements.namedItem("vendor") as HTMLInputElement).value = e.vendor;
      (form.elements.namedItem("category") as HTMLSelectElement).value = e.category;
      (form.elements.namedItem("amount") as HTMLInputElement).value = String(e.amount);
      ensurePaidByOption(e.paidBy);
      paidBySelect.value = e.paidBy;
      (form.elements.namedItem("status") as HTMLSelectElement).value = e.status;
      (form.elements.namedItem("notes") as HTMLInputElement).value = e.notes ?? "";
      (form.elements.namedItem("expiryDate") as HTMLInputElement).value = e.expiryDate;
      (form.elements.namedItem("autoRenewal") as HTMLSelectElement).value = e.autoRenewal;
      documentInput.value = "";
      formHeading.textContent = "Edit purchase";
      submitButton.textContent = "Save changes";
      cancelEditButton.classList.remove("hidden");
      if (e.documentUrl) {
        existingDocumentNote.textContent = `Current document: ${e.documentName || "attached file"} — choosing a new file below replaces it.`;
        existingDocumentNote.classList.remove("hidden");
      } else {
        existingDocumentNote.classList.add("hidden");
      }
      form.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    const inr = (n: number) => `₹${n.toLocaleString("en-IN")}`;
    const fmtDate = (iso: string) =>
      new Date(`${iso}T00:00:00`).toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric" });
    const statusClass: Record<string, string> = {
      Paid: "bg-emerald-100 text-emerald-800",
      Pending: "bg-amber-100 text-amber-900",
      Reimbursable: "bg-blue/10 text-blue",
    };

    const cell = (text: string, className = "") => {
      const td = document.createElement("td");
      td.className = `px-3 py-3 ${className}`;
      td.textContent = text;
      return td;
    };

    function renderStats() {
      const monthPrefix = new Date().toISOString().slice(0, 7);
      const sum = (list: Expense[]) => list.reduce((total, e) => total + e.amount, 0);
      $("stat-total").textContent = inr(sum(expenses));
      $("stat-month").textContent = inr(sum(expenses.filter((e) => e.date.startsWith(monthPrefix))));
      $("stat-open").textContent = inr(sum(expenses.filter((e) => e.status !== "Paid")));
    }

    const sorters: Record<string, (a: Expense, b: Expense) => number> = {
      "date-desc": (a, b) => b.date.localeCompare(a.date),
      "date-asc": (a, b) => a.date.localeCompare(b.date),
      "amount-desc": (a, b) => b.amount - a.amount,
      "amount-asc": (a, b) => a.amount - b.amount,
      "expiry-asc": (a, b) => a.expiryDate.localeCompare(b.expiryDate),
      "item-asc": (a, b) => a.item.localeCompare(b.item),
    };

    function visibleExpenses() {
      const query = searchBox.value.trim().toLowerCase();
      return expenses
        .filter((e) => (!filterCategory.value || e.category === filterCategory.value) && (!filterStatus.value || e.status === filterStatus.value))
        .filter((e) => !query || [e.item, e.vendor, e.paidBy, e.notes ?? "", e.category].some((text) => text.toLowerCase().includes(query)))
        .sort(sorters[sortBy.value] ?? sorters["date-desc"]);
    }

    function render() {
      const shown = visibleExpenses();
      $("count").textContent = `(${shown.length})`;
      $("shown-total").textContent = inr(shown.reduce((total, e) => total + e.amount, 0));

      rows.replaceChildren(
        ...shown.map((e, i) => {
          const tr = document.createElement("tr");
          tr.className = "animate-in";
          tr.style.animationDelay = `${Math.min(i, 10) * 40}ms`;

          const item = document.createElement("td");
          item.className = "px-3 py-3";
          item.innerHTML = "<div class='font-medium text-navy'></div><div class='text-xs text-text-muted'></div>";
          item.children[0].textContent = e.item;
          item.children[1].textContent = [e.vendor, e.notes].filter(Boolean).join(" · ");

          const statusTd = document.createElement("td");
          statusTd.className = "px-3 py-3";
          const badge = document.createElement("span");
          badge.className = `rounded-full px-2.5 py-1 text-xs font-medium ${statusClass[e.status] ?? ""}`;
          badge.textContent = e.status;
          statusTd.append(badge);

          const actions = document.createElement("td");
          actions.className = "px-3 py-3 text-right";
          const actionsWrap = document.createElement("div");
          actionsWrap.className = "flex items-center justify-end gap-1";

          const edit = iconButton("icon-tpl-edit", "Edit purchase", "hover:text-blue");
          edit.addEventListener("click", () => enterEditMode(e));

          const remove = iconButton("icon-tpl-delete", "Delete purchase", "hover:text-red-600");
          remove.addEventListener("click", async () => {
            if (!confirm(`Delete "${e.item}"?`)) return;
            try {
              await deleteExpense(e.id);
            } catch (err) {
              showError(err instanceof ApiError ? err.message : "Could not delete that expense.");
              return;
            }
            expenses = expenses.filter((x) => x.id !== e.id);
            if (editingId === e.id) enterAddMode();
            renderAll();
          });

          actionsWrap.append(edit, remove);
          actions.append(actionsWrap);

          const expiryTd = cell(fmtDate(e.expiryDate), "whitespace-nowrap");
          if (e.autoRenewal === "Yes") {
            const badge = document.createElement("span");
            badge.className = "ml-1.5 rounded-full bg-bg-alt px-1.5 py-0.5 text-[10px] font-medium text-text-muted align-middle";
            badge.textContent = "Auto-renews";
            expiryTd.append(badge);
          }

          const documentTd = document.createElement("td");
          documentTd.className = "px-3 py-3";
          if (e.documentUrl) {
            const link = document.createElement("a");
            link.href = e.documentUrl;
            link.target = "_blank";
            link.rel = "noopener noreferrer";
            link.className = "text-xs font-medium text-blue hover:underline";
            link.textContent = e.documentName || "View";
            documentTd.append(link);
          } else {
            documentTd.className += " text-xs text-text-muted";
            documentTd.textContent = "—";
          }

          tr.append(
            cell(String(i + 1), "text-text-muted"),
            cell(fmtDate(e.date), "whitespace-nowrap"),
            item,
            cell(e.category),
            cell(e.paidBy),
            cell(inr(e.amount), "text-right font-medium text-navy whitespace-nowrap"),
            statusTd,
            expiryTd,
            documentTd,
            actions,
          );
          return tr;
        }),
      );
    }

    const renderAll = () => {
      renderStats();
      render();
    };

    filterCategory.addEventListener("change", render);
    filterStatus.addEventListener("change", render);
    sortBy.addEventListener("change", render);
    searchBox.addEventListener("input", render);

    const csvCell = (value: string) => `"${value.replace(/"/g, '""')}"`;

    function downloadCsv() {
      const shown = visibleExpenses();
      const headers = ["S.No", "Date", "Item", "Vendor", "Category", "Amount (INR)", "Paid by", "Status", "Expiry date", "Auto renewal", "Document", "Notes"];
      const lines = [headers.map(csvCell).join(",")];
      shown.forEach((e, i) => {
        lines.push(
          [String(i + 1), e.date, e.item, e.vendor, e.category, String(e.amount), e.paidBy, e.status, e.expiryDate, e.autoRenewal, e.documentUrl ?? "", e.notes ?? ""]
            .map(csvCell)
            .join(","),
        );
      });
      // Leading BOM so Excel detects UTF-8 rather than mis-decoding the ₹ symbol / non-ASCII text.
      const blob = new Blob(["﻿" + lines.join("\r\n")], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = `expenses-${new Date().toISOString().slice(0, 10)}.csv`;
      link.click();
      URL.revokeObjectURL(url);
    }

    $("download-excel").addEventListener("click", downloadCsv);

    const documentInput = $("document") as HTMLInputElement;
    const documentError = $("document-error");
    const showDocumentError = (message: string) => {
      documentError.textContent = message;
      documentError.classList.remove("hidden");
    };

    cancelEditButton.addEventListener("click", enterAddMode);

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      documentError.classList.add("hidden");
      if (!form.reportValidity()) return;

      const file = documentInput.files?.[0];
      if (file) {
        if (!DOCUMENT_ALLOWED_TYPES.includes(file.type)) {
          showDocumentError("Only PDF, JPG, or PNG files are accepted.");
          return;
        }
        if (file.size > DOCUMENT_MAX_BYTES) {
          showDocumentError(`That file is too large -- the limit is ${DOCUMENT_MAX_BYTES / (1024 * 1024)} MB.`);
          return;
        }
      }

      const v = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      submitButton.disabled = true;
      try {
        let documentUrl = editingDocument.documentUrl;
        let documentName = editingDocument.documentName;
        if (file) {
          const uploaded = await uploadExpenseDocument(file);
          documentUrl = uploaded.documentUrl;
          documentName = uploaded.documentName;
        }

        const payload = {
          date: v.date,
          item: v.item.trim(),
          vendor: v.vendor.trim(),
          category: v.category as Expense["category"],
          amount: Number(v.amount),
          paidBy: v.paidBy.trim(),
          status: v.status as Expense["status"],
          notes: (v.notes ?? "").trim(),
          expiryDate: v.expiryDate,
          autoRenewal: v.autoRenewal as Expense["autoRenewal"],
          documentUrl,
          documentName,
        };

        if (editingId) {
          const updated = await updateExpense(editingId, payload);
          expenses = expenses.map((x) => (x.id === updated.id ? updated : x));
          enterAddMode();
        } else {
          const created = await createExpense(payload);
          expenses.push(created);
          enterAddMode();
        }
        renderAll();
      } catch (err) {
        showError(err instanceof ApiError ? err.message : "Could not save that expense.");
      } finally {
        submitButton.disabled = false;
      }
    });

    renderAll();
  }

  init();
</script>
